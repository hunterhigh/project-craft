{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.project-foundation.dev/schema/v1.json",
  "title": "Project Foundation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "foundationVersion",
    "language",
    "project",
    "classification",
    "technology",
    "modules",
    "assumptions",
    "decisions",
    "externalActions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "foundationVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "language": { "type": "string", "minLength": 2 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug", "summary", "problem", "users", "firstRelease", "notInScope", "successCriteria"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "summary": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "users": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "firstRelease": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "notInScope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "successCriteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productType", "userShape", "runShape", "collaborationShape", "stage", "riskLevel", "riskDimensions"],
      "properties": {
        "productType": { "enum": ["web", "internal-tool", "api", "automation", "data", "mobile", "skill"] },
        "userShape": { "enum": ["owner-only", "internal-multi-user", "business-customer", "consumer-public"] },
        "runShape": { "enum": ["local", "on-demand", "scheduled", "continuous"] },
        "collaborationShape": { "enum": ["solo", "ai-assisted", "team", "company"] },
        "stage": { "enum": ["idea", "prototype", "internal", "production", "critical"] },
        "riskLevel": { "enum": ["low", "standard", "critical"] },
        "riskDimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data", "identity", "money", "privacy", "externalSystems", "automation", "businessDependency"],
          "properties": {
            "data": { "$ref": "#/$defs/risk" },
            "identity": { "$ref": "#/$defs/risk" },
            "money": { "$ref": "#/$defs/risk" },
            "privacy": { "$ref": "#/$defs/risk" },
            "externalSystems": { "$ref": "#/$defs/risk" },
            "automation": { "$ref": "#/$defs/risk" },
            "businessDependency": { "$ref": "#/$defs/risk" }
          }
        }
      }
    },
    "technology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "deploymentProfile", "rationale"],
      "properties": {
        "adapter": { "enum": ["docs-only", "typescript-node", "python", "codex-skill"] },
        "deploymentProfile": { "enum": ["none", "cloudflare", "generic"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/module" }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "reviewByStage"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "reviewByStage": { "$ref": "#/$defs/stage" }
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "context", "choice", "rationale", "alternatives", "consequences", "reviewWhen"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "context": { "type": "string", "minLength": 1 },
          "choice": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "alternatives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "consequences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "reviewWhen": { "type": "string", "minLength": 1 }
        }
      }
    },
    "externalActions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createRepository", "configureRemote", "provisionCloud", "setSecrets", "deploy"],
      "properties": {
        "createRepository": { "const": false },
        "configureRemote": { "const": false },
        "provisionCloud": { "const": false },
        "setSecrets": { "const": false },
        "deploy": { "const": false }
      }
    }
  },
  "$defs": {
    "risk": { "enum": ["none", "low", "standard", "critical", "unknown"] },
    "stage": { "enum": ["prototype", "internal", "production", "critical"] },
    "module": {
      "enum": [
        "project-brief", "decisions", "git", "github", "versioning", "stage-gates", "testing", "secrets", "continuity",
        "environments", "release", "database", "data-lifecycle", "backup-recovery", "external-api", "scheduled-jobs", "auth",
        "security", "operations", "cost-capacity", "accessibility", "public-api", "ai", "open-source", "payments",
        "multi-tenant", "mobile"
      ]
    }
  }
}
